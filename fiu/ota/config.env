PORT=3000
USE_DASHBOARD=true
DASHBOARD_ROOT_REDIRECT=true
CACHE_MODE=local
STORAGE_MODE=s3
AWS_REGION=auto
AWS_S3_FORCE_PATH_STYLE=true
BUCKET_KEY_PREFIX=updates
TRUST_PROXY_HEADERS=true
TRUST_PROXY_DEPTH=1
ARCHIVE_AUDIT_LOGS=false
BUNDLE_DIFFING=false
UPLOAD_SOURCEMAPS=false
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DISABLE_TELEMETRY=true
